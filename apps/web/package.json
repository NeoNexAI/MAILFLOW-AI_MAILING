{
  "name": "@mailflow/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "auth:generate": "WEB_AUTH=on better-auth generate --config src/lib/auth.ts --output ./better-auth-schema.sql -y",
    "auth:migrate": "WEB_AUTH=on better-auth migrate --config src/lib/auth.ts -y"
  },
  "dependencies": {
    "better-auth": "1.6.18",
    "next": "15.1.3",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.7.2"
  }
}
