# Next.js 15 (standalone) — frontend de MailFlow.
FROM node:20-slim AS base
RUN corepack enable
WORKDIR /app

# --- deps + build ---
FROM base AS builder
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @mailflow/web...
COPY apps/web apps/web
# NEXT_PUBLIC_* se hornean en build; se pueden sobreescribir con build-args.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm --filter @mailflow/web build

# --- runtime ---
FROM base AS runner
ENV NODE_ENV=production
# La salida standalone trae el server + node_modules trazados.
COPY --from=builder --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=node:node /app/apps/web/public ./apps/web/public
# Ejecutar como el usuario `node` (sin privilegios), incluido en la imagen base.
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
